<Project Sdk="Microsoft.NET.Sdk">

  <!-- CLI 前端：命令即动词，参数即选择器，输出 JSON。
       默认内嵌执行（本机零配置）；带 agent 参数则转为调用常驻服务（前端/后端分离的体现）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>GuIO.Cli</RootNamespace>
    <AssemblyName>guio</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>../../../assets/guio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Service\GuIO.Service.csproj" />
    <ProjectReference Include="..\..\Drivers\GuIO.Driver.Windows\GuIO.Driver.Windows.csproj" />
    <ProjectReference Include="..\..\Transport\GuIO.Transport.csproj" />
  </ItemGroup>

</Project>
