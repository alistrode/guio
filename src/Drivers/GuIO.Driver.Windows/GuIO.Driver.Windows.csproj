<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 驱动：唯一直接接触 Windows 平台 API 的地方。
       语义层用 FlaUI(UIA3)、注入用 SendInput、截屏用 WGC、音频用 NAudio。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>GuIO.Driver.Windows</RootNamespace>
    <AssemblyName>GuIO.Driver.Windows</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GuIO.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\GuIO.Contracts.csproj" />
    <ProjectReference Include="..\..\Vision\GuIO.Vision.csproj" />
  </ItemGroup>

</Project>
